<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_root_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_safe_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_cover_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_meta_click"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/widget_default_title"
                        android:textColor="@color/widget_title_color"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/widget_default_artist"
                        android:textColor="@color/widget_artist_color"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/widget_btn_prev"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/widget_touch_ripple"
                        android:clickable="true"
                        android:contentDescription="@string/widget_prev_track"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/widget_btn_prev_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_btn_circle"
                            android:tint="@color/widget_secondary_bg_fallback"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/widget_btn_prev_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_player_previous"
                            android:tint="@color/widget_secondary_icon_fallback" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:id="@+id/widget_btn_play"
                        android:layout_width="50dp"
                        android:layout_height="40dp"
                        android:background="@drawable/widget_touch_ripple"
                        android:clickable="true"
                        android:contentDescription="@string/widget_play"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/widget_btn_play_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_btn_squircle"
                            android:tint="@color/widget_play_bg_fallback"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/widget_btn_play_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_player_play"
                            android:tint="@color/widget_play_icon_fallback" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:id="@+id/widget_btn_next"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/widget_touch_ripple"
                        android:clickable="true"
                        android:contentDescription="@string/widget_next_track"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/widget_btn_next_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_btn_circle"
                            android:tint="@color/widget_secondary_bg_fallback"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/widget_btn_next_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_player_next"
                            android:tint="@color/widget_secondary_icon_fallback" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_up_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_up_next"
            android:textColor="@color/widget_muted_color"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/widget_next_row_1"
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/widget_next_bg_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_queue_card_bg"
                android:tint="@color/widget_queue_card_bg_fallback" />

            <LinearLayout
                android:id="@+id/widget_next_click_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_card_ripple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/widget_next_cover_1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/widget_cover_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_next_title_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/widget_title_color"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_next_artist_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/widget_artist_color"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/widget_empty_queue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_no_upcoming"
            android:textColor="@color/widget_muted_color"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
